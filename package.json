  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "prettier": "@marcalexiei/prettier-config",
  "scripts": {
    "prepare": "husky",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "markdownlint . --config .markdownlint.json --ignore node_modules",
    "lint:fix": "pnpm lint --fix",
    "spellcheck": "cspell . --show-context",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check-all": "pnpm run \"/^(format|lint|spellcheck)$/\""
  },
  "devDependencies": {
    "@marcalexiei/prettier-config": "2.0.0",
    "cspell": "10.0.0",
    "husky": "9.1.7",
    "markdownlint": "0.40.0",
    "markdownlint-cli": "0.48.0",
    "prettier": "3.8.3",
    "vitepress": "1.6.4"
  }
}
