  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "prettier": "@marcalexiei/prettier-config",
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "markdownlint . --config .markdownlint.json --ignore node_modules",
    "lint:fix": "pnpm lint --fix",
    "spellcheck": "cspell . --show-context",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check-all": "pnpm run \"/^(format|lint|spellcheck)$/\""
  },
  "devDependencies": {
    "@marcalexiei/prettier-config": "2.0.0",
    "cspell": "10.0.1",
    "lefthook": "2.1.10",
    "markdownlint": "0.41.1",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.6",
    "vitepress": "2.0.0-alpha.21"
  }
}
