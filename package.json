  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "prettier": "@marcalexiei/prettier-config",
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "markdownlint . --config .markdownlint.json --ignore node_modules",
    "lint:fix": "pnpm lint --fix",
    "spellcheck": "cspell . --show-context",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check-all": "pnpm run \"/^(format|lint|spellcheck)$/\""
  },
  "devDependencies": {
    "@marcalexiei/prettier-config": "2.0.0",
    "cspell": "10.0.1",
    "lefthook": "2.1.10",
    "markdownlint": "0.41.1",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.6",
    "vitepress": "2.0.0-alpha.18"
  }
}
